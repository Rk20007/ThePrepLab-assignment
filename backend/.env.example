# Which LLM provider to use: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the main model is overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Groq key (https://console.groq.com/keys) - only needed if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: regex for origins that change per deploy (e.g. Vercel preview URLs)
# ALLOWED_ORIGIN_REGEX=https://your-frontend-.*\.vercel\.app

# Upload limit in megabytes
MAX_UPLOAD_MB=5
